# Rust's output directory
target

# Test snapshots (generated by soroban-sdk testutils)
fluxapay/test_snapshots
# Test snapshots (auto-generated, not tracked)
**/test_snapshots/

# Local settings
.soroban
.stellar

# Git worktrees (linked checkouts — never commit these)
.worktrees/

# Environment variables (do not commit secrets)
# Written by scripts/deploy-testnet.sh and scripts/onboard.sh, and holds a
# deployer/merchant secret key (Issue #818).
.env.testnet
.env.mainnet

# Node.js
node_modules
dist

# actionlint binary (installed at CI runtime via rhysd/actionlint action)
/actionlint
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
config.bat
